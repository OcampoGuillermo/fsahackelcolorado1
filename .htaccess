# Protección básica del sitio (funciona con Apache en XAMPP)
Options -Indexes
AddDefaultCharset UTF-8

# Bloquear acceso a carpetas internas desde el navegador
RedirectMatch 403 /(inc|database|scripts|cache)(/|$)

# En desarrollo se pueden revisar los logs de Apache; no exponer errores al navegador
php_flag display_errors Off
php_flag log_errors On